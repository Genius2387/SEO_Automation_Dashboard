

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL="https://seo-dashboard.yourdomain.com"

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL - Neon / Supabase)
# ------------------------------------------------------------------------------
# Pooled connection string for application runtime queries (e.g., PgBouncer / Neon pooler)
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection string for Prisma migrations & schema pushes (bypasses transaction poolers)
DIRECT_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 3. REDIS & QUEUE (Upstash Redis for BullMQ)
# ------------------------------------------------------------------------------
# Upstash Redis TLS connection string for BullMQ workers and queue producers
REDIS_URL="rediss://default:YOUR_UPSTASH_TOKEN@your-database.upstash.io:6379"

# ------------------------------------------------------------------------------
# 4. ANTHROPIC CLAUDE API
# ------------------------------------------------------------------------------
# Required for AI-powered SEO analysis & recommendations
ANTHROPIC_API_KEY="sk-ant-api03-placeholder-replace-with-your-key"
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ------------------------------------------------------------------------------
# 5. EXECUTION & GRANULAR MOCK CONTROLS
# ------------------------------------------------------------------------------
# Central fallback mock switch (set 'false' for full live production)
USE_MOCKS="true"

# Granular Mock Flags (Option A configuration: Real Crawler + Mock AI + Mock Providers)
# CRAWLER_USE_MOCKS: 'false' enables real Cheerio HTML crawling even when USE_MOCKS is 'true'.
CRAWLER_USE_MOCKS="false"

# AI_USE_MOCKS: 'true' uses deterministic evidence-grounded Mock Claude without API credits.
# Set to 'false' in production with a valid ANTHROPIC_API_KEY.
AI_USE_MOCKS="true"

# SEO_PROVIDER_USE_MOCKS: 'true' mocks PageSpeed, Search Console, and DataForSEO.
SEO_PROVIDER_USE_MOCKS="true"

# ------------------------------------------------------------------------------
# 6. CRON & SCHEDULING AUTHENTICATION
# ------------------------------------------------------------------------------
# Cryptographic shared secret required by POST/GET /api/cron/audits
CRON_SECRET="generate-a-strong-random-cron-secret-32-chars-min"

# ------------------------------------------------------------------------------
# 7. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Administrative master key for role bootstrap and admin bypass
ADMIN_SECRET_KEY="generate-a-strong-admin-secret-key"
# HMAC secret for session and anti-CSRF token verification
SESSION_SECRET="generate-a-strong-64-character-session-secret-key"
CSRF_SECRET="generate-a-strong-64-character-csrf-secret-key"

# ------------------------------------------------------------------------------
# 8. REPORT STORAGE (Local Filesystem or Cloudflare R2)
# ------------------------------------------------------------------------------
# Storage provider: 'local' for local disk or 'r2' for Cloudflare R2 (S3-compatible)
REPORT_STORAGE_PROVIDER="local"
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="edgelink-reports-production"
# Optional custom public/CDN domain if bucket is public (leave empty for private signed URLs)
R2_PUBLIC_URL=""

# ------------------------------------------------------------------------------
# 9. NOTIFICATIONS: TWILIO WHATSAPP
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# ------------------------------------------------------------------------------
# 10. NOTIFICATIONS: EMAIL (SMTP or Resend)
# ------------------------------------------------------------------------------
# Email provider: 'smtp', 'resend', or empty to disable
EMAIL_PROVIDER="smtp"
EMAIL_FROM="EdgeLink SEO Reports <reports@yourdomain.com>"
# SMTP Configuration
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASS="your-smtp-password"
# Or Resend API Key
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
